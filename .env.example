JWT_SECRET=your_jwt_secret_here
# Frontend build-time: absolute URL of the backend API (e.g. https://kio-lol.onrender.com)
# Leave empty when serving frontend+backend from the same origin (Render default).
VITE_API_URL=https://kio-lol.onrender.com
APP_URL=https://kio.lol
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@kio.lol
DISCORD_BOT_TOKEN=your_discord_bot_token
CAPTCHA_SECRET=your_captcha_secret
NODE_ENV=production
PORT=3001
# Turso/libSQL remote database (persists across Render redeploys)
# Create a free database at https://turso.tech and copy the libsql URL + token.
TURSO_DB_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_token
